# CareerPilot AI backend configuration.
# Copy to backend/.env and edit. Every value below is read with the CP_ prefix.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

CP_APP_ENV=production
CP_DEBUG=false
CP_LOG_LEVEL=INFO

# REQUIRED in production. Sessions and CSRF tokens are signed with this value.
CP_SECRET_KEY=replace-with-at-least-32-random-characters
# REQUIRED before storing any AI provider key. Without it, configs cannot be saved.
# Use a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CP_AI_ENCRYPTION_KEY=

# The exact public origin of the frontend. Mutating requests from other origins are rejected.
CP_FRONTEND_ORIGIN=https://careerpilot.example
# Comma-separated hostnames the API accepts. Never use * in production.
CP_ALLOWED_HOSTS=careerpilot.example,api.careerpilot.example

# PostgreSQL is the authoritative store. The initial migration creates all 41 tables.
CP_DATABASE_URL=postgresql+psycopg://careerpilot:change-me@localhost:5432/careerpilot
# Keep false in production and run `alembic upgrade head` instead of creating tables at boot.
CP_AUTO_CREATE_SCHEMA=false

# Uploaded CVs and generated exports live here. Use a persistent volume.
CP_MEDIA_ROOT=/var/lib/careerpilot/media
CP_MAX_UPLOAD_MB=10
CP_EXPORT_LINK_TTL_SECONDS=300

# Secure cookies default to true when CP_APP_ENV=production.
# CP_COOKIE_SECURE=true
# CP_COOKIE_DOMAIN=

# Email. Without SMTP, verification and reset links are logged instead of sent,
# and the API reports email_configured=false.
CP_SMTP_HOST=
CP_SMTP_PORT=587
CP_SMTP_USER=
CP_SMTP_PASSWORD=
CP_SMTP_STARTTLS=true
CP_EMAIL_FROM=CareerPilot AI <no-reply@careerpilot.example>
CP_REQUIRE_EMAIL_VERIFICATION=true
# Only enable on disposable environments; it exposes reset tokens in API responses.
CP_EXPOSE_DEV_TOKENS=false

# Background worker. Run a dedicated worker process in production and set this to false.
CP_ENABLE_INLINE_WORKER=false
CP_TASK_POLL_SECONDS=1.5
CP_TASK_MAX_ATTEMPTS=3

# AI providers are optional. Users bring their own provider and key in Settings.
CP_AI_DAILY_OUTPUT_TOKEN_LIMIT=100000
CP_AI_TIMEOUT_SECONDS=60
CP_AI_ALLOW_PRIVATE_ENDPOINTS=false
# Optional JSON price table for cost estimates, e.g. {"gpt-4o-mini": {"input": 0.15, "output": 0.6}}
# Prices are per million tokens. With no table, the UI shows tokens and no cost estimate.
CP_AI_PRICING_JSON={}

# Rate limits (per user/IP per minute).
CP_RATE_LIMIT_ENABLED=true
CP_RATE_LIMIT_PER_MINUTE=180
CP_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Outbound job fetching. Private/loopback destinations are blocked by default.
CP_JOB_FETCH_TIMEOUT_SECONDS=12
CP_JOB_FETCH_ALLOW_PRIVATE_HOSTS=false
CP_JOB_DISCOVERY_USER_AGENT=CareerPilotAI/1.0 (+job-import; contact: support@careerpilot.example)
