{
  "name": "careerpilot-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Native desktop shell for a CareerPilot AI workspace",
  "author": {
    "name": "CareerPilot maintainers",
    "email": "Obiorachibuike@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Obiorachibuike/Necron.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --devtools",
    "test": "node --test",
    "icons": "python3 scripts/generate-icons.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "publish:linux": "electron-builder --linux --publish always",
    "publish:win": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.careerpilot.desktop",
    "productName": "CareerPilot",
    "copyright": "Copyright \u00a9 2026 CareerPilot contributors",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "build/tray.png",
      "build/tray@2x.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json",
      "!**/*.map",
      "!**/test/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "protocols": [
      {
        "name": "CareerPilot workspace link",
        "schemes": [
          "careerpilot"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Obiorachibuike",
        "repo": "Necron",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons",
      "synopsis": "Native desktop shell for your CareerPilot workspace",
      "description": "CareerPilot Desktop opens your self-hosted CareerPilot AI workspace in a native window with a tray, native notifications, downloads and automatic updates. The workspace itself runs on the server you connect to.",
      "maintainer": "CareerPilot maintainers <Obiorachibuike@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "CareerPilot",
          "Comment": "Evidence-first career workspace",
          "Categories": "Office;Utility;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CareerPilot",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
